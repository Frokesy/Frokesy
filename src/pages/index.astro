---
import "../styles/global.css";
import HeroScene from "../components/HeroScene";
import InteractiveNav from "../components/InteractiveNav";
import MotionReveal from "../components/MotionReveal";
import ScrollDirector from "../components/ScrollDirector";
import PageExperience from "../components/PageExperience";

const nav = [
  { href: "#work", label: "Work", number: "01" }, { href: "#about", label: "About", number: "02" },
  { href: "#experience", label: "Experience", number: "03" }, { href: "#contact", label: "Contact", number: "04" },
];
const projects = [
  { number: "01", title: "Mando", kind: "Multi-role commerce platform", copy: "A mobile-first food ordering and delivery ecosystem for customers, restaurants, riders, sales agents, and administrators.", tags: ["Next.js", "Payments", "Role-based systems"], live: "https://www.mando.com.ng", github: "", visual: "mando", note: "700+ users · 265 agents · ₦356k+ first 100 orders" },
  { number: "02", title: "Frokes Cast", kind: "Browser-to-browser casting", copy: "A secure casting MVP where a phone pairs to a TV through QR or code and controls browser media and YouTube playback in real time.", tags: ["React PWA", "WebSockets", "Kotlin"], live: "https://frokes-cast.vercel.app", github: "https://github.com/Frokesy/frokes-cast", visual: "cast", note: "Shared protocol · reconnect tokens · runtime validation" },
  { number: "03", title: "Frokes OS", kind: "Personal operating system · WIP", copy: "A calm, offline-first space for vocabulary, emotional check-ins, and financial awareness with durable sync and private local data.", tags: ["Next.js", "Offline-first", "PostgreSQL"], live: "https://frokes-os.vercel.app", github: "https://github.com/Frokesy/frokes_os", visual: "os", note: "Local-first records · durable mutation queue" },
  { number: "04", title: "PitchLab", kind: "Football tactics PWA", copy: "A board-first workspace for coaches to shape formations, move players, draw actions, save plays, and share tactical ideas.", tags: ["React 19", "TypeScript", "Framer Motion"], live: "https://pitchlab-gamma.vercel.app", github: "https://github.com/Frokesy/pitchlab", visual: "pitch", note: "The Figma for football tactics" },
  { number: "05", title: "OneStepAhead", kind: "Digital experience", copy: "A responsive public-facing platform developed as a polished, accessible React experience across desktop and mobile.", tags: ["React", "TypeScript", "Responsive UI"], live: "https://1stepahead-five.vercel.app", github: "https://github.com/Frokesy/osa", visual: "osa", note: "Design-led frontend implementation" },
  { number: "06", title: "GoatClouds", kind: "E-commerce templates", copy: "A collection of expressive commerce storefront concepts built to explore product presentation, layout systems, and reusable UI.", tags: ["React", "E-commerce", "UI systems"], live: "https://gcet.vercel.app", github: "https://github.com/Frokesy/gcet", visual: "shop", note: "Reusable storefront concepts" },
];
const projectImages: Record<string, string> = {
  mando: "/projects/mando.png", os: "/projects/frokes-os.png",
  pitch: "/projects/pitchlab.png", osa: "/projects/osa.png", shop: "/projects/gcet.png",
};
const roles = [
  ["2026", "Mando", "Software Engineer", "Built and launched a five-role ordering platform with payments, delivery tracking, commissions, refunds, payouts, and operational dashboards."],
  ["2025", "Rehubot", "Software Engineer", "Shipped scalable SaaS features, reusable components, Stripe flows, and offline-first integrations with PocketBase and IndexedDB."],
  ["2024", "Freshbake", "Frontend Engineer", "Developed a mobile-first PWA with Google Maps delivery workflows, caching, performance optimization, and production refactoring."],
  ["2023", "Dexterpro", "Frontend Developer", "Translated design mockups into precise, responsive websites and tested production flows across devices."],
  ["2022—23", "WHEXcosystem", "Web Developer", "Led UI improvements, SEO work, production fixes, and blockchain-related purchase integrations."],
  ["2020—21", "Luxuriant Flower School", "Frontend Developer", "Built responsive experiences and collaborated on a student record system that improved record-keeping by 25%."],
];
const title = "Ayanfeoluwa Akindele — Product-minded Frontend Engineer";
const description = "Frontend engineer with 5+ years of experience building high-performance web products, payment flows, PWAs, dashboards, and interaction-rich interfaces.";
const siteUrl = new URL(import.meta.env.PUBLIC_SITE_URL || "https://frokesy.vercel.app");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL("/og-image.png", siteUrl);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person", "@id": `${siteUrl}#person`, name: "Ayanfeoluwa Akindele",
      url: siteUrl.toString(), image: socialImage.toString(), jobTitle: "Frontend Engineer",
      email: "mailto:akindeleayanfeoluwa@gmail.com", address: { "@type": "PostalAddress", addressCountry: "NG" },
      sameAs: ["https://github.com/Frokesy", "https://www.linkedin.com/in/ayanfeoluwa-akindele-5838b0233/", "https://twitter.com/_frokes"],
      knowsAbout: ["React", "Next.js", "TypeScript", "Progressive Web Apps", "Frontend Engineering", "Web Performance", "Payment Integrations", "Interaction Design"],
    },
    {
      "@type": "WebSite", "@id": `${siteUrl}#website`, url: siteUrl.toString(), name: "Ayanfeoluwa Akindele Portfolio",
      description, inLanguage: "en", author: { "@id": `${siteUrl}#person` },
    },
    {
      "@type": "ItemList", name: "Selected frontend engineering projects",
      itemListElement: projects.map((project, index) => ({ "@type": "ListItem", position: index + 1, url: project.live, name: project.title, description: project.copy })),
    },
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="generator" content={Astro.generator} />
    <title>{title}</title><meta name="description" content={description} /><meta name="author" content="Ayanfeoluwa Akindele" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" /><meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="keywords" content="Ayanfeoluwa Akindele, frontend engineer, React developer, Next.js developer, TypeScript developer, frontend developer Nigeria, PWA developer, product engineer" />
    <meta name="theme-color" content="#f1eee5" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#11110f" media="(prefers-color-scheme: dark)" /><meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} /><link rel="manifest" href="/site.webmanifest" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="en_NG" /><meta property="og:site_name" content="Ayanfeoluwa Akindele Portfolio" /><meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={socialImage} /><meta property="og:image:secure_url" content={socialImage} /><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="AA — Ayanfeoluwa Akindele, product-minded frontend engineer" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:creator" content="@_frokes" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content="AA — Ayanfeoluwa Akindele portfolio" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <ScrollDirector client:load /><PageExperience client:load /><a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><a class="identity" href="#top"><span>AA®</span><small>Frontend engineer<br />Osun, Nigeria</small></a><InteractiveNav items={nav} client:load /></header>
    <main id="main">
      <section class="hero" id="top">
        <div class="hero__status"><span></span> Available for select opportunities</div>
        <h1><span>I engineer</span><em>digital products</em><span>people feel.</span></h1>
        <div class="hero__sculpture" aria-label="Interactive three dimensional ribbon sculpture"><div class="hero__ring">Build / move / refine / repeat /</div><HeroScene client:load /><span class="hero__badge">5+<small>years<br />shipping</small></span></div>
        <div class="hero__bottom"><p>Product-minded frontend engineer building fast, scalable experiences—from payment flows and PWAs to operational dashboards and expressive interfaces.</p><a class="text-link" href="#work">Explore selected work <span>↘</span></a></div>
      </section>
      <section class="marquee" aria-label="Core technologies"><div>React · Next.js · TypeScript · GSAP · Framer Motion · PWAs · Three.js · <span>React · Next.js · TypeScript · GSAP · Framer Motion · PWAs · Three.js ·</span></div></section>
      <section class="section projects" id="work" data-gsap-section><div class="section-rule"><span class="section-rule__fill"></span></div><header class="section-heading"><p>01 / Selected work</p><h2>Things I’ve<br /><em>made real.</em></h2><span>Six products · 2023—2026</span></header>
        <div class="project-list">{projects.map((project) => <MotionReveal client:visible><article class={`case case--${project.visual}`}><div class="case__head"><span>{project.number}</span><p>{project.kind}</p></div><div class="case__visual">{project.visual === "cast" ? <div class="dual-shot"><img class="dual-shot__tv" src="/projects/frokes-cast-tv.png" alt="Frokes Cast TV pairing screen" loading="lazy" /><img class="dual-shot__phone" src="/projects/frokes-cast-connect.png" alt="Frokes Cast mobile controller" loading="lazy" /></div> : <img class={`project-shot project-shot--${project.visual}`} src={projectImages[project.visual]} alt={`${project.title} interface`} loading="lazy" />}</div><div class="case__copy"><div><h3>{project.title}</h3><p>{project.copy}</p></div><div class="case__meta"><p>{project.note}</p><ul>{project.tags.map((tag) => <li>{tag}</li>)}</ul></div><div class="case__links"><a href={project.live} target="_blank" rel="noreferrer">Live site ↗</a>{project.github && <a href={project.github} target="_blank" rel="noreferrer">Source ↗</a>}</div></div></article></MotionReveal>)}</div>
      </section>
      <section class="section about" id="about" data-gsap-section><div class="section-rule"><span class="section-rule__fill"></span></div><header class="section-heading"><p>02 / About</p><h2>Engineering<br />with <em>taste.</em></h2></header><MotionReveal className="about__body" client:visible><p class="about__lead">I turn complex product and business requirements into interfaces that stay clear, reliable, and genuinely enjoyable to use.</p><div class="about__columns"><p>My work spans payment systems, multi-role platforms, offline-first products, API integrations, PWAs, and operations tooling. I care about the architecture beneath an interface as much as the details people can see.</p><p>Based in Nigeria, I work remotely with teams that value ownership, thoughtful execution, and frontend engineering that contributes to the product—not only the pixels.</p></div><div class="metrics"><div><strong>700+</strong><span>users on Mando</span></div><div><strong>13×</strong><span>agent-network growth</span></div><div><strong>70%</strong><span>engagement improvement</span></div></div></MotionReveal></section>
      <section class="section experience" id="experience" data-gsap-section><div class="section-rule"><span class="section-rule__fill"></span></div><header class="section-heading"><p>03 / Experience</p><h2>The work<br /><em>behind it.</em></h2><a class="text-link" href="/Ayanfeoluwa-Akindele-resume.docx" download>Download résumé ↓</a></header><div class="role-list">{roles.map((role) => <article><time>{role[0]}</time><div><h3>{role[1]}</h3><span>{role[2]}</span></div><p>{role[3]}</p></article>)}</div></section>
      <section class="contact" id="contact" data-gsap-section><div class="contact__label">04 / Start a conversation</div><h2>Have something<br /><em>worth building?</em></h2><a class="contact__email" href="mailto:akindeleayanfeoluwa@gmail.com">akindeleayanfeoluwa@gmail.com <span>↗</span></a><footer><p>© {new Date().getFullYear()} Ayanfeoluwa Akindele</p><nav><a href="https://github.com/Frokesy">GitHub</a><a href="https://www.linkedin.com/in/ayanfeoluwa-akindele-5838b0233/">LinkedIn</a><a href="https://twitter.com/_frokes">X</a><a href="https://wa.me/2349157881431?text=Hi%20Ayanfeoluwa%2C%20I%20found%20your%20portfolio%20and%20would%20love%20to%20connect." target="_blank" rel="noopener noreferrer" aria-label="Message Ayanfeoluwa on WhatsApp">WhatsApp</a></nav><p>Lagos time · WAT</p></footer></section>
    </main>
  </body>
</html>
